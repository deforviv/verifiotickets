# Supabase > Connect > Transaction pooler. URL-encode special characters in the password.
POSTGRES_URL=postgresql://postgres.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@<POOLER_HOST>:6543/postgres?workaround=supabase-pooler.vercel

# Private Dashboard access code. Replace with your own strong value.
VERIFIO_ADMIN_CODE=replace-with-a-private-code

# Generate a separate random value (example: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))")
VERIFIO_SESSION_SECRET=replace-with-a-random-secret

# Public production domain, without a trailing slash.
PUBLIC_URL=https://your-project.vercel.app
