{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__apiPath=:path*" },
    { "source": "/v/:path*", "destination": "/index.html" },
    { "source": "/verify/:path*", "destination": "/index.html" }
  ]
}
